# .dockerignore - Files to exclude from Docker build context

# Git
.git
.gitignore
.gitattributes

# Python. A pattern without a slash is anchored at the context root, unlike
# git: **/ is what reaches backend/venv and the like.
**/__pycache__/
**/*.py[cod]
*$py.class
**/*.so
.Python
**/env/
**/venv/
**/.venv/
**/ENV/
**/coverage_html/
**/.ruff_cache/
**/.mypy_cache/
**/build/
develop-eggs/
# Root-anchored on purpose: **/dist/ would exclude frontend/dist, the built
# interface the image serves, and the image would come out without a UI
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
**/*.egg-info/
.installed.cfg
*.egg

# Testing
**/.pytest_cache/
**/.coverage
.tox/
**/htmlcov/
test*.py
*_test.py

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation (included in image separately)
docs/
*.md
!README.md

# Node dependencies: the image serves frontend/dist, never the sources
**/node_modules/

# Data directories (mounted as volumes)
backend/data/
data/
**/*.db
**/*.db-journal

# Logs
**/*.log
**/logs/

# Temporary files
**/tmp/
**/temp/
*.tmp

# Backup files
*.backup
*.old
*.bak
*~

# Installation scripts (not needed in container)
install*.sh
uninstall.sh
upgrade.sh
scripts/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# Package files
*.tar.gz
*.zip

# Environment files with secrets
**/.env
**/.env.local

# Keep .env.example for container initialization
!.env.example
