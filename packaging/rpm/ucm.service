[Unit]
Description=Ultimate Certificate Manager (UCM)
Documentation=https://github.com/NeySlim/ultimate-ca-manager
After=network.target

[Service]
Type=exec
User=ucm
Group=ucm
WorkingDirectory=/opt/ucm/backend

# Environment
EnvironmentFile=-/etc/ucm/ucm.env

# Start gunicorn directly using config file
ExecStart=/opt/ucm/venv/bin/gunicorn -c gunicorn_config.py wsgi:app

# Journal access. The diagnostic bundle and the log viewer read this unit's own
# journal with `journalctl -u ucm`, which needs membership of systemd-journal.
# Granted here rather than with a usermod at install time: it is visible in the
# unit, it is revocable by commenting out one line and restarting, and it is
# scoped to this service rather than to every process the account can start.
SupplementaryGroups=systemd-journal

# Standard output. Both are systemd's default, but stated here so the journal
# destination the diagnostic bundle collects is not an implicit one, and so
# entries carry the same identifier the DEB unit gives them.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ucm

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ucm/data /var/log/ucm /etc/ucm
# SoftHSM writes its tokens here; "-" keeps the unit starting where SoftHSM is absent.
ReadWritePaths=-/var/lib/softhsm/tokens
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Restart policy
Restart=always
RestartSec=10s

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
