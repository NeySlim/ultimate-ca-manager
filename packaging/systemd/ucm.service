[Unit]
Description=Ultimate Certificate Manager (UCM)
Documentation=https://github.com/NeySlim/ultimate-ca-manager
After=network.target
# Any failure but a refused database restarts the service, at most 5 times in 5 minutes
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=ucm
Group=ucm
WorkingDirectory=/opt/ucm/backend

# Environment
EnvironmentFile=-/etc/ucm/ucm.env

# Start gunicorn directly using config file
ExecStart=/opt/ucm/venv/bin/gunicorn -c gunicorn_config.py wsgi:app
ExecReload=/bin/kill -HUP $MAINPID

# Journal access. The diagnostic bundle and the log viewer read this unit's own
# journal with `journalctl -u ucm`, which needs membership of systemd-journal.
# Granted here rather than with a usermod at install time: it is visible in the
# unit, it is revocable by commenting out one line and restarting, and it is
# scoped to this service rather than to every process the account can start.
SupplementaryGroups=systemd-journal

# Standard output. Both are systemd's default, but stated here so the journal
# destination the diagnostic bundle collects is not an implicit one.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ucm

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ucm/data /var/log/ucm /etc/ucm
# Older layouts; "-" keeps the unit starting where a package did not create them
ReadWritePaths=-/opt/ucm/backend/data -/var/lib/ucm
# SoftHSM writes its tokens here; "-" keeps the unit starting where SoftHSM is absent.
ReadWritePaths=-/var/lib/softhsm/tokens
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Restart policy. A database the release refuses exits 78 (EX_CONFIG): restarting
# cannot change it, so the unit stays failed until the cause is fixed. Restarts
# asked from the interface go through ucm-watcher, which resets the start limit
# first: StartLimitBurst counts crashes, not restarts asked for.
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=78

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
# Workers drain for up to 30 s, then the scheduler process stops
TimeoutStopSec=90s

[Install]
WantedBy=multi-user.target
