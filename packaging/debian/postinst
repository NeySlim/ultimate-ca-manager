#!/bin/bash
# UCM Post-Installation Script (non-interactive)

set -e

PACKAGE="ucm"
UCM_USER="ucm"
UCM_GROUP="ucm"
UCM_HOME="/opt/ucm"
UCM_DATA="/opt/ucm/data"
UCM_CONFIG="/etc/ucm"

case "$1" in
    configure)
        # Bytecode written at run time is not the package's: a new source of the same size and
        # date as the old one would load the old .pyc, so it goes before any Python runs
        find "$UCM_HOME/backend" "$UCM_HOME/scripts" -name __pycache__ -type d -prune \
            -exec rm -rf -- {} + 2>/dev/null || true

        # Create user and group
        if ! getent group "$UCM_GROUP" >/dev/null 2>&1; then
            addgroup --system "$UCM_GROUP" >/dev/null
        fi
        
        if ! getent passwd "$UCM_USER" >/dev/null 2>&1; then
            adduser --system --home "$UCM_HOME" --no-create-home \
                    --ingroup "$UCM_GROUP" --disabled-password \
                    --shell /bin/false "$UCM_USER" >/dev/null
        fi
        
        mkdir -p /var/log/ucm
        
        # SoftHSM setup: add ucm user to softhsm/ods group and prepare token directory
        HSM_GROUP=""
        if getent group softhsm >/dev/null 2>&1; then
            HSM_GROUP="softhsm"
        elif getent group ods >/dev/null 2>&1; then
            HSM_GROUP="ods"
        fi
        if [ -n "$HSM_GROUP" ]; then
            usermod -aG "$HSM_GROUP" "$UCM_USER" 2>/dev/null || true
        fi
        mkdir -p /var/lib/softhsm/tokens
        if [ -n "$HSM_GROUP" ]; then
            chown root:"$HSM_GROUP" /var/lib/softhsm/tokens
            chmod 1770 /var/lib/softhsm/tokens
        fi
        
        # sudoers-cleanup: no sudo grant any more (the watcher restarts the service);
        # drop the files earlier versions wrote. Absent file or directory is fine.
        rm -f /etc/sudoers.d/ucm-service /etc/sudoers.d/ucm
        # end sudoers-cleanup

        # Enable ucm-watcher for restart/update handling
        # Units are installed to /lib/systemd/system/ by the package
        systemctl daemon-reload 2>/dev/null || true
        systemctl enable ucm-watcher.path 2>/dev/null || true
        systemctl start ucm-watcher.path 2>/dev/null || true
        
        UCM_SETUP="$UCM_HOME/scripts/native-setup.sh"
        NEW_CONFIG=""
        # Resumed after a failed first attempt: the service never had a working venv
        # ($2 is empty for a first configure, so an upgrade never shows the banner)
        [ -n "$2" ] || bash "$UCM_SETUP" venv-ok "$UCM_HOME" || NEW_CONFIG=1

        # Built before anything is written to the data or the configuration: the archiving
        # below asks this release's runner about the database left there
        echo "Creating/updating Python virtual environment..."
        BUILT_FIPS=""
        ! bash "$UCM_SETUP" fips-requested "$UCM_CONFIG/ucm.env" || BUILT_FIPS=1
        bash "$UCM_SETUP" venv "$UCM_HOME" python3 deb "$UCM_CONFIG/ucm.env"

        # A new install (nothing configured, or a removed UCM older than 2.254, which no
        # upgrade reaches), an earlier attempt that failed or was killed (its mark, or an
        # archive journal left) archives what a removed UCM left when this release refuses
        # it. The mark is set first; a failure stops here: nothing below may run.
        ARCHIVE_PENDING="$UCM_HOME/.leftover-archive-pending"
        . "$UCM_HOME/scripts/pivot-guard.sh"
        ARCHIVE_DUE=""
        if [ -z "$2" ] || ! ucm_pivot_version_ok "$2" || [ -e "$ARCHIVE_PENDING" ]; then
            ARCHIVE_DUE=1
        fi
        for journal in "${UCM_HOME%/*}"/ucm-archive/*/.journal; do
            [ ! -e "$journal" ] || ARCHIVE_DUE=1
        done
        # 3: a database left in place that the service will refuse, which the archiver
        # has explained: no success banner follows that
        LEFT_REFUSED=""
        if [ -n "$ARCHIVE_DUE" ]; then
            : > "$ARCHIVE_PENDING"
            ARCHIVE_RC=0
            UCM_RETRY="dpkg --configure -a" UCM_PYTHON=python3 sh "$UCM_HOME/scripts/archive-leftovers.sh" "$UCM_HOME" "$UCM_DATA" "$UCM_CONFIG" || ARCHIVE_RC=$?
            case $ARCHIVE_RC in
                0) ;;
                3) LEFT_REFUSED=1 ;;
                # The archiver said the retry, before its last line
                1|2) exit 1 ;;
                *) echo "UCM was not set up. Fix the cause, then run: dpkg --configure -a"
                   exit 1 ;;
            esac
            rm -f "$ARCHIVE_PENDING"
            # A retry built the venv while ucm.env was still in the archive; the archiver
            # then carried its UCM_FIPS_BUILD=1 over: the standard venv is built again
            if [ -z "$BUILT_FIPS" ] && bash "$UCM_SETUP" fips-requested "$UCM_CONFIG/ucm.env"; then
                echo "UCM_FIPS_BUILD=1 came back after the Python environment was built: building it again against the system OpenSSL..."
                bash "$UCM_SETUP" venv "$UCM_HOME" python3 deb "$UCM_CONFIG/ucm.env"
            fi
        fi

        # Create directories
        mkdir -p "$UCM_DATA"/{ca,certs,private,crl,scep,backups,sessions}
        mkdir -p "$UCM_CONFIG"

        # Create config if not exists (fresh install). /etc/ucm is the service account's: a link
        # or anything but a file there stops the install, and the new file is written by own
        bash "$UCM_SETUP" env-check "$UCM_CONFIG/ucm.env"
        if [ ! -f "$UCM_CONFIG/ucm.env" ]; then
            NEW_CONFIG=1
            SECRET_KEY=$(python3 -c 'import secrets; print(secrets.token_hex(32))')

            bash "$UCM_SETUP" own write "$UCM_CONFIG/ucm.env" 600 << ENVEOF
# ============================================================
# UCM Configuration File
# ============================================================
# This file is sourced by the UCM service at startup.
# Edit values below and restart UCM: systemctl restart ucm

# ============ REQUIRED (auto-generated) ============
SECRET_KEY=$SECRET_KEY
DATABASE_PATH=$UCM_DATA/ucm.db

# ============ NETWORK ============
HTTPS_PORT=8443
HTTP_PROTOCOL_PORT=8080
# HTTP_REDIRECT=true
# FQDN=ucm.example.com

# ============ LOGGING ============
LOG_LEVEL=INFO

# ============ SECURITY ============
# Session lifetime and lockout are set in Settings > Security.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_TRUST_LAN=true
# RATE_LIMIT_AUTH_RPM=30
# RATE_LIMIT_AUTH_BURST=10
# RATE_LIMIT_HEAVY_RPM=60
# RATE_LIMIT_HEAVY_BURST=15
# RATE_LIMIT_STANDARD_RPM=600
# RATE_LIMIT_STANDARD_BURST=100
# RATE_LIMIT_PROTOCOL_RPM=500
# RATE_LIMIT_PROTOCOL_BURST=100

# ============ HTTPS CERTIFICATES ============
# HTTPS_CERT_PATH=/opt/ucm/data/https_cert.pem
# HTTPS_KEY_PATH=/opt/ucm/data/https_key.pem
# HTTPS_AUTO_GENERATE=true

# ============ INITIAL ADMIN (first start only) ============
# Unset: the first start writes a generated password to
# $UCM_DATA/initial-admin-password (read it with sudo cat), to change at first login.
# To choose it, write one of these into this file BEFORE installing the package
# (it starts UCM), and remove it after the first start:
# INITIAL_ADMIN_PASSWORD_FILE=/etc/ucm/admin-password   (readable by the ucm user)
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_EMAIL=admin@ucm.local

# SCEP is configured in the web interface (Protocols > SCEP), not here.

# ============ DATABASE POOL (advanced) ============
# DB_POOL_SIZE=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600
# DB_MAX_OVERFLOW=20

# ============ REDIS (optional, for HA) ============
# REDIS_URL=redis://localhost:6379/0
ENVEOF
        fi
        # A file written before the install (UCM_FIPS_BUILD=1 alone) gets its secrets and defaults
        ENV_STATE=$(bash "$UCM_SETUP" env "$UCM_CONFIG/ucm.env" "$UCM_DATA")
        [ "$ENV_STATE" != new ] || NEW_CONFIG=1
        
        # Always ensure config has correct paths (for upgrades from older versions)
        bash "$UCM_SETUP" env-ensure "$UCM_CONFIG/ucm.env" DATA_DIR "$UCM_DATA"
        
        # Set permissions, through a linked directory too (the final /), never through a link inside;
        # a local archive of a removed UCM's files (.ucm-archive-*) and the DNS hooks stay root's.
        # The home, its scripts and venv are root's: the account gets only what its unit writes
        bash "$UCM_SETUP" own chown-tree "$UCM_HOME/" root:root data backend/data
        bash "$UCM_SETUP" own chown-tree "$UCM_DATA/" "$UCM_USER:$UCM_GROUP"
        if [ -d "$UCM_HOME/backend/data" ] && [ ! -L "$UCM_HOME/backend/data" ]; then
            bash "$UCM_SETUP" own chown-tree "$UCM_HOME/backend/data" "$UCM_USER:$UCM_GROUP"
        fi
        bash "$UCM_SETUP" own chown-tree "$UCM_CONFIG/" "$UCM_USER:$UCM_GROUP" dns-hooks
        bash "$UCM_SETUP" own chown-tree /var/log/ucm/ "$UCM_USER:$UCM_GROUP"
        bash "$UCM_SETUP" own mode "$UCM_DATA/" 750

        # Host FIPS state, UCM_FIPS and readiness report (UCM_FIPS_BUILD=1 only)
        bash "$UCM_SETUP" fips-finish "$UCM_HOME" "$UCM_CONFIG/ucm.env" "$UCM_DATA" "$UCM_USER"
        # Shown once the venv is built, so a failed build never follows the banner
        if [ -n "$NEW_CONFIG" ] && [ -z "$LEFT_REFUSED" ]; then
            bash "$UCM_SETUP" banner "$UCM_CONFIG/ucm.env" deb
        fi
        
        # Generate HTTPS cert if not exists, never through a link the service account laid
        bash "$UCM_SETUP" https-cert "$UCM_DATA" "$UCM_USER" "$UCM_GROUP"
        
        # Enable and start/restart service
        systemctl daemon-reload 2>/dev/null || true
        systemctl enable ucm || true
        # Wanted, not a crash: not counted by the start limit (StartLimitBurst)
        systemctl reset-failed ucm 2>/dev/null || true
        if systemctl is-active --quiet ucm; then
            systemctl restart ucm || true
        else
            systemctl start ucm || true
        fi
        
        # ============================================================
        # FIREWALL CONFIGURATION
        # ============================================================
        # Configure firewall if script exists: only with UCM_FIREWALL=yes, never a prompt
        #   UCM_PORT=8443 UCM_FIREWALL=yes dpkg -i ucm.deb
        if [ -x "$UCM_HOME/scripts/configure-firewall.sh" ]; then
            "$UCM_HOME/scripts/configure-firewall.sh" || true
        fi
        ;;
esac

exit 0
