#!/bin/bash
# UCM Post-Installation Script (non-interactive)

set -e

PACKAGE="ucm"
UCM_USER="ucm"
UCM_GROUP="ucm"
UCM_HOME="/opt/ucm"
UCM_DATA="/opt/ucm/data"
UCM_CONFIG="/etc/ucm"
V1_DATA="/opt/ucm/backend/data"

case "$1" in
    configure)
        # Create user and group
        if ! getent group "$UCM_GROUP" >/dev/null 2>&1; then
            addgroup --system "$UCM_GROUP" >/dev/null
        fi
        
        if ! getent passwd "$UCM_USER" >/dev/null 2>&1; then
            adduser --system --home "$UCM_HOME" --no-create-home \
                    --ingroup "$UCM_GROUP" --disabled-password \
                    --shell /bin/false "$UCM_USER" >/dev/null
        fi
        
        # Create directories
        mkdir -p "$UCM_DATA"/{ca,certs,private,crl,scep,backups,sessions}
        mkdir -p "$UCM_CONFIG"
        mkdir -p /var/log/ucm
        
        # SoftHSM setup: add ucm user to softhsm/ods group and prepare token directory
        HSM_GROUP=""
        if getent group softhsm >/dev/null 2>&1; then
            HSM_GROUP="softhsm"
        elif getent group ods >/dev/null 2>&1; then
            HSM_GROUP="ods"
        fi
        if [ -n "$HSM_GROUP" ]; then
            usermod -aG "$HSM_GROUP" "$UCM_USER" 2>/dev/null || true
        fi
        mkdir -p /var/lib/softhsm/tokens
        if [ -n "$HSM_GROUP" ]; then
            chown root:"$HSM_GROUP" /var/lib/softhsm/tokens
            chmod 1770 /var/lib/softhsm/tokens
        fi
        
        # ============================================================
        # AUTOMATIC MIGRATION FROM v1.8.x
        # ============================================================
        # Check multiple possible v1.8.x data locations
        V1_DB=""
        if [ -f "$V1_DATA/ucm.db" ]; then
            V1_DB="$V1_DATA/ucm.db"
        elif [ -f "/var/lib/ucm/ucm.db" ] && [ ! -f "$UCM_DATA/ucm.db" ]; then
            # v1.8.3 DEB package used /var/lib/ucm
            V1_DB="/var/lib/ucm/ucm.db"
        fi
        
        if [ -n "$V1_DB" ] && [ ! -f "$UCM_DATA/ucm.db" ]; then
            echo ""
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo " Detected UCM v1.8.x data"
            echo " Migrating to v2.0.0..."
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            
            # Copy DB first
            cp "$V1_DB" "$UCM_DATA/ucm.db"
            chown "$UCM_USER":"$UCM_GROUP" "$UCM_DATA/ucm.db"
            
            # Copy files from v1.8.x data dir if exists
            V1_DIR=$(dirname "$V1_DB")
            for dir in ca certs private crl; do
                if [ -d "$V1_DIR/$dir" ] && [ "$(ls -A $V1_DIR/$dir 2>/dev/null)" ]; then
                    cp -r "$V1_DIR/$dir"/* "$UCM_DATA/$dir/" 2>/dev/null || true
                fi
            done
            
            # Update DATABASE_PATH in existing config if needed
            if [ -f "$UCM_CONFIG/ucm.env" ]; then
                sed -i "s|DATABASE_PATH=.*|DATABASE_PATH=$UCM_DATA/ucm.db|" "$UCM_CONFIG/ucm.env"
            fi
            
            # Schema migrations are run automatically at app startup
            echo "✓ Migration complete (schema migrations will run at first startup)"
        fi
        # ============================================================
        
        # Sudoers for service restart (watcher handles restart/update)
        cat > /etc/sudoers.d/ucm-service << 'SUDOERS'
ucm ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart ucm, /usr/bin/systemctl reload ucm
ucm ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop ucm, /usr/bin/systemctl start ucm
SUDOERS
        chmod 440 /etc/sudoers.d/ucm-service
        
        # Enable ucm-watcher for restart/update handling
        # Units are installed to /lib/systemd/system/ by the package
        systemctl daemon-reload
        systemctl enable ucm-watcher.path 2>/dev/null || true
        systemctl start ucm-watcher.path 2>/dev/null || true
        
        UCM_SETUP="$UCM_HOME/scripts/native-setup.sh"
        NEW_CONFIG=""

        # Create config if not exists (fresh install)
        if [ ! -f "$UCM_CONFIG/ucm.env" ]; then
            NEW_CONFIG=1
            SECRET_KEY=$(python3 -c 'import secrets; print(secrets.token_hex(32))')
            ADMIN_PASS="changeme123"
            
            cat > "$UCM_CONFIG/ucm.env" << ENVEOF
# ============================================================
# UCM Configuration File
# ============================================================
# This file is sourced by the UCM service at startup.
# Edit values below and restart UCM: systemctl restart ucm

# ============ REQUIRED (auto-generated) ============
SECRET_KEY=$SECRET_KEY
DATABASE_PATH=$UCM_DATA/ucm.db

# ============ NETWORK ============
HTTPS_PORT=8443
HTTP_PROTOCOL_PORT=8080
# HTTP_REDIRECT=true
# FQDN=ucm.example.com

# ============ LOGGING ============
LOG_LEVEL=INFO

# ============ SECURITY ============
# Session lifetime and lockout are set in Settings > Security.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_TRUST_LAN=true
# RATE_LIMIT_AUTH_RPM=30
# RATE_LIMIT_AUTH_BURST=10
# RATE_LIMIT_HEAVY_RPM=60
# RATE_LIMIT_HEAVY_BURST=15
# RATE_LIMIT_STANDARD_RPM=600
# RATE_LIMIT_STANDARD_BURST=100
# RATE_LIMIT_PROTOCOL_RPM=500
# RATE_LIMIT_PROTOCOL_BURST=100

# ============ HTTPS CERTIFICATES ============
# HTTPS_CERT_PATH=/opt/ucm/data/https_cert.pem
# HTTPS_KEY_PATH=/opt/ucm/data/https_key.pem
# HTTPS_AUTO_GENERATE=true

# ============ INITIAL ADMIN (first start only) ============
INITIAL_ADMIN_PASSWORD=$ADMIN_PASS
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_EMAIL=admin@ucm.local

# SCEP is configured in the web interface (Protocols > SCEP), not here.

# ============ DATABASE POOL (advanced) ============
# DB_POOL_SIZE=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600
# DB_MAX_OVERFLOW=20

# ============ REDIS (optional, for HA) ============
# REDIS_URL=redis://localhost:6379/0
ENVEOF
            chmod 600 "$UCM_CONFIG/ucm.env"
        fi
        # A file written before the install (UCM_FIPS_BUILD=1 alone) gets its secrets and defaults
        ENV_STATE=$(bash "$UCM_SETUP" env "$UCM_CONFIG/ucm.env" "$UCM_DATA")
        [ "$ENV_STATE" != new ] || NEW_CONFIG=1
        # Resumed after a failed first attempt: the service never had a working venv
        # ($2 is empty for a first configure, so an upgrade never shows the banner)
        [ -n "$2" ] || bash "$UCM_SETUP" venv-ok "$UCM_HOME" || NEW_CONFIG=1
        
        # Always ensure config has correct paths (for upgrades from older versions)
        if [ -f "$UCM_CONFIG/ucm.env" ]; then
            # Update DATABASE_PATH if pointing to old location
            sed -i "s|DATABASE_PATH=/var/lib/ucm/ucm.db|DATABASE_PATH=$UCM_DATA/ucm.db|" "$UCM_CONFIG/ucm.env"
            # Ensure DATA_DIR is set
            grep -q "^DATA_DIR=" "$UCM_CONFIG/ucm.env" || echo "DATA_DIR=$UCM_DATA" >> "$UCM_CONFIG/ucm.env"
        fi
        
        # Always recreate venv to ensure correct dependencies
        # This handles both fresh install and upgrades
        echo "Creating/updating Python virtual environment..."
        bash "$UCM_SETUP" venv "$UCM_HOME" python3 deb "$UCM_CONFIG/ucm.env"

        # Set permissions
        chown -R "$UCM_USER":"$UCM_GROUP" "$UCM_HOME"
        chown -R "$UCM_USER":"$UCM_GROUP" "$UCM_DATA"
        chown -R "$UCM_USER":"$UCM_GROUP" "$UCM_CONFIG"
        chown -R "$UCM_USER":"$UCM_GROUP" /var/log/ucm
        chmod 750 "$UCM_DATA"

        # Host FIPS state, UCM_FIPS and readiness report (UCM_FIPS_BUILD=1 only)
        bash "$UCM_SETUP" fips-finish "$UCM_HOME" "$UCM_CONFIG/ucm.env" "$UCM_DATA" "$UCM_USER"
        # Shown once the venv is built, so a failed build never follows the banner
        if [ -n "$NEW_CONFIG" ]; then
            bash "$UCM_SETUP" banner "$UCM_CONFIG/ucm.env" deb
        fi
        
        # Install sudoers file to allow service management
        if [ -f "$UCM_HOME/sudoers/ucm" ]; then
            cp "$UCM_HOME/sudoers/ucm" /etc/sudoers.d/ucm
            chmod 440 /etc/sudoers.d/ucm
            chown root:root /etc/sudoers.d/ucm
        fi
        
        # Generate HTTPS cert if not exists
        if [ ! -f "$UCM_DATA/https_cert.pem" ]; then
            echo "Generating HTTPS certificate..."
            # Detect hostname and IPs for SAN
            CERT_HOST=$(hostname -f 2>/dev/null || hostname)
            CERT_IPS=""
            for ip in $(hostname -I 2>/dev/null); do
                CERT_IPS="${CERT_IPS},IP:${ip}"
            done
            CERT_SAN="DNS:${CERT_HOST},DNS:localhost,IP:127.0.0.1${CERT_IPS}"
            
            openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
                -keyout "$UCM_DATA/https_key.pem" \
                -out "$UCM_DATA/https_cert.pem" \
                -subj "/CN=${CERT_HOST}/O=UCM/OU=PKI" \
                -addext "subjectAltName=${CERT_SAN}" 2>/dev/null
            chown "$UCM_USER":"$UCM_GROUP" "$UCM_DATA"/https_*.pem
            chmod 600 "$UCM_DATA/https_key.pem"
            chmod 644 "$UCM_DATA/https_cert.pem"
        fi
        
        # Enable and start/restart service
        systemctl daemon-reload
        systemctl enable ucm
        if systemctl is-active --quiet ucm; then
            systemctl restart ucm || true
        else
            systemctl start ucm || true
        fi
        
        # ============================================================
        # FIREWALL CONFIGURATION
        # ============================================================
        # Configure firewall if script exists
        # Can be controlled via environment variables:
        #   UCM_PORT=8443 UCM_FIREWALL=yes dpkg -i ucm.deb
        # Or interactively if no env vars set
        if [ -x "$UCM_HOME/scripts/configure-firewall.sh" ]; then
            "$UCM_HOME/scripts/configure-firewall.sh" || true
        fi
        ;;
esac

exit 0
